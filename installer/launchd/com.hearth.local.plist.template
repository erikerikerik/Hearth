<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@RES@/run_server.py</string>
  </array>
  <key>WorkingDirectory</key><string>@RES@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HEARTH_DATA_DIR</key><string>@DATA@</string>
    <key>HEARTH_PORT</key><string>@PORT@</string>
    <!-- Loopback http only: Secure cookies are not needed on 127.0.0.1 and some browsers reject them there. -->
    <key>HEARTH_COOKIE_SECURE</key><string>0</string>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@LOGS@/server.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/server.log</string>
</dict>
</plist>
